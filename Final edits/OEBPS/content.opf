    <!-- Title -->
    <dc:title id="title">Curls &amp; Contemplation: A Stylist&#x2019;s Interactive Journey</dc:title>
    <meta refines="#title" property="title-type">main</meta>
    <meta refines="#title" property="display-seq">1</meta>

    <!-- Creator -->
    <dc:creator id="creator">Michael David</dc:creator>
